# Django
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database
DATABASE_URL=sqlite:///db.sqlite3

# SMS Provider (console, mock)
SMS_PROVIDER=console
SMS_API_KEY=
SMS_API_SECRET=

# Email
DEFAULT_FROM_EMAIL=noreply@payia.com
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True

# Media
MEDIA_ROOT=media
STATIC_ROOT=staticfiles

# ── Tara Money (depots en ligne automatiques) ──────────────────────────────
# Clés fournies par Tara Money (côté serveur uniquement).
TARA_API_KEY=
TARA_BUSINESS_ID=
TARA_API_BASE_URL=https://www.dklo.co/api/tara
# Jeton partagé intégré à l'URL du webhook.
# Générer avec : python -c "import secrets; print(secrets.token_urlsafe(32))"
TARA_WEBHOOK_TOKEN=
# URL publique HTTPS du site (returnUrl / webHookUrl envoyés à Tara).
TARA_SITE_BASE_URL=https://payia.example.com
TARA_HTTP_TIMEOUT=15
# Durée de vie d'une tentative de paiement (secondes)
TARA_ATTEMPT_TTL=1800
# Fenêtre de réutilisation d'un dépôt en attente (anti double-clic)
TARA_REUSE_WINDOW=900
# Limites de dépôt (le minimum peut être surchargé par Setting minimum_deposit)
TARA_DEPOSIT_MIN=2500
TARA_DEPOSIT_MAX=5000000
# Réconciliation des webhooks manquants
TARA_RECONCILE_BATCH=20
TARA_RECONCILE_LOOKBACK_HOURS=72
TARA_STATUS_THROTTLE=5
